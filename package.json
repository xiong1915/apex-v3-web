{
  "name": "apex-v3-web",
  "version": "3.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "APEX V3 - Formula 1 Data + Intelligence Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser/lights-out.cjs",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test tests/*.test.*",
    "check:copy": "node scripts/check-copy.mjs",
    "check:dates": "node ./node_modules/tsx/dist/cli.mjs --test tests/date-rules.test.mjs",
    "quality": "npm run check:copy && npm run check:dates && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/redis": "^1.34.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
